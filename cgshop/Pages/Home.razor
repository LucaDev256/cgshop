@page "/"
@inject HttpClient Http
@inject NavigationManager navigationManager


<PageTitle>Catalogue</PageTitle>



<MudGrid Style="padding: 3em;">

    @foreach (var f in products)
    {
        <MudItem sm="12" md="4">
            <cgshop.Components.Product Prod="f"></cgshop.Components.Product>
        </MudItem>

    }


</MudGrid>

@code {
    public List<Models.Product> products = new();
    public readonly string BrandPath = "media/branding.png";

    protected override async Task OnInitializedAsync()
    {
        var basePath = navigationManager.BaseUri; // gives https://lucadev256.github.io/cgshop/
        var dataPath = $"{basePath}data/products.json";
        products = await Http.GetFromJsonAsync<List<Models.Product>>(dataPath) ?? new();
    
        // products = await Http.GetFromJsonAsync<List<Models.Product>>("data/products.json") ?? new();
    }

}